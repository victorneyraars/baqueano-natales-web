---
import { restaurants } from '../../data/menus';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return Object.keys(restaurants).map((slug) => ({
    params: { slug },
    props: { restaurant: restaurants[slug] },
  }));
}

const { restaurant } = Astro.props;
---

<Layout title={`${restaurant.name} | Carta Digital Baqueano Natales`}>
  <div class="min-h-screen bg-slate-950 text-slate-100 pb-28">
    
    <!-- Smart App Banner Superior -->
    <div class="bg-gradient-to-r from-emerald-950 via-slate-900 to-emerald-950 border-b border-emerald-500/30 px-4 py-2.5 flex items-center justify-between sticky top-0 z-40 backdrop-blur-md">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-base">
          ✨
        </div>
        <div>
          <p class="text-[11px] font-bold text-white leading-tight">Superapp Baqueano</p>
          <p class="text-[10px] text-emerald-300">Pedidos directos y delivery en Natales</p>
        </div>
      </div>
      <a
        href="/descargar"
        class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-black px-3.5 py-1.5 rounded-full transition-all shadow-md shadow-emerald-500/20 active:scale-95 whitespace-nowrap"
      >
        Instalar App
      </a>
    </div>

    <!-- Header del Restaurante -->
    <header class="relative bg-gradient-to-b from-slate-900 to-slate-950 border-b border-slate-800/80 px-4 py-6 text-center">
      <div class="max-w-xl mx-auto">
        <div class="text-4xl mb-2">{restaurant.logo}</div>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">{restaurant.name}</h1>
        <p class="text-xs sm:text-sm text-emerald-300 font-medium mt-1">{restaurant.type}</p>
        <p class="text-xs text-slate-400 mt-2 flex items-center justify-center gap-1">
          📍 {restaurant.address}
        </p>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-2xl mx-auto px-4 mt-5">
      
      <!-- Selector Interactivo de Categorías -->
      <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-none no-scrollbar" id="category-bar">
        <button
          class="cat-btn active bg-emerald-600 text-white font-bold text-xs px-4 py-2 rounded-full whitespace-nowrap shadow-md transition-all"
          data-category="all"
        >
          Todo el Menú
        </button>
        {restaurant.categories.map((cat) => (
          <button
            class="cat-btn bg-slate-900 border border-slate-800 text-slate-300 font-medium text-xs px-4 py-2 rounded-full whitespace-nowrap hover:bg-slate-800 transition-all"
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Banner Informativo: Pedidos centralizados en la App -->
      <div class="mt-4 bg-slate-900 border border-emerald-500/30 rounded-2xl p-3.5 flex items-center justify-between gap-3">
        <div class="text-left">
          <span class="inline-block bg-emerald-500/20 text-emerald-300 text-[9px] font-bold px-1.5 py-0.5 rounded uppercase tracking-wider mb-0.5">Atención Directa</span>
          <p class="text-xs font-bold text-white">Los pedidos se procesan exclusivamente por la App</p>
          <p class="text-[11px] text-slate-400">Tu orden llega directamente a la cocina del local.</p>
        </div>
        <a
          href="/descargar"
          class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-black px-3.5 py-2 rounded-xl transition active:scale-95 whitespace-nowrap"
        >
          Abrir App
        </a>
      </div>

      <!-- Listado de Platos -->
      <div class="grid gap-3.5 mt-5" id="menu-items-list">
        {restaurant.items.map((item) => (
          <div
            class="menu-item-card bg-slate-900/90 border border-slate-800/90 rounded-2xl p-4 flex flex-col justify-between hover:border-emerald-500/40 transition-all"
            data-category={item.category}
          >
            <div class="flex justify-between items-start gap-3">
              <div class="flex-1">
                {item.tag && (
                  <span class="inline-block bg-amber-500/20 text-amber-300 text-[10px] font-bold px-2 py-0.5 rounded-md mb-1.5 uppercase tracking-wider">
                    {item.tag}
                  </span>
                )}
                <h3 class="text-base font-bold text-white leading-snug">{item.name}</h3>
                <p class="text-xs text-slate-400 mt-1 leading-relaxed">{item.description}</p>
              </div>
              <div class="text-right whitespace-nowrap">
                <span class="text-base font-extrabold text-emerald-400">
                  ${item.price.toLocaleString('es-CL')}
                </span>
              </div>
            </div>
            
            <div class="mt-3.5 pt-3 border-t border-slate-800/60 flex items-center justify-between">
              <span class="text-[11px] text-slate-500 font-medium">{item.category}</span>
              <a
                href="/descargar"
                class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 active:scale-95 shadow-sm"
              >
                <span>Pedir en la App</span>
                <span>📲</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Footer Studio Digital 360 -->
      <div class="mt-12 text-center text-xs text-slate-500 border-t border-slate-900 pt-6">
        <p>Carta Digital Interactiva • Red Baqueano Natales</p>
        <p class="mt-1 font-semibold text-slate-400">
          Tecnología desarrollada por <a href="https://studiodigital360.com" target="_blank" class="text-emerald-400 hover:underline">Studio Digital 360</a>
        </p>
      </div>
    </main>

    <!-- Sticky Bottom Bar -->
    <div class="fixed bottom-0 left-0 right-0 p-3 bg-slate-950/95 border-t border-slate-800 backdrop-blur-lg z-40">
      <div class="max-w-md mx-auto flex items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <span class="text-xl">🛵</span>
          <div class="leading-tight">
            <p class="text-xs font-bold text-white">¿Deseas pedir este menú?</p>
            <p class="text-[10px] text-slate-400">Pídelo directo al local desde la app oficial</p>
          </div>
        </div>
        <a
          href="/descargar"
          class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-black px-4 py-2.5 rounded-xl shadow-lg shadow-emerald-500/30 active:scale-95 transition-all text-center"
        >
          Descargar App
        </a>
      </div>
    </div>
  </div>

  <script>
    const buttons = document.querySelectorAll('.cat-btn');
    const cards = document.querySelectorAll('.menu-item-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('active', 'bg-emerald-600', 'text-white', 'shadow-md');
          b.classList.add('bg-slate-900', 'text-slate-300', 'border-slate-800');
        });

        btn.classList.add('active', 'bg-emerald-600', 'text-white', 'shadow-md');
        btn.classList.remove('bg-slate-900', 'text-slate-300', 'border-slate-800');

        const selectedCategory = btn.getAttribute('data-category');

        cards.forEach((card) => {
          const itemCategory = card.getAttribute('data-category');
          if (selectedCategory === 'all' || itemCategory === selectedCategory) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
