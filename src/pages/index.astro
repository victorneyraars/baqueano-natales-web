---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---
<Layout title="Baqueano Natales - La Superapp de Puerto Natales">
  <nav class="p-6 bg-white shadow-sm">
    <h1 class="text-2xl font-bold text-blue-900">Baqueano Natales</h1>
  </nav>
  <main class="container mx-auto p-6">
    <section class="py-20 text-center">
      <h2 class="text-5xl font-extrabold text-blue-950">Tu aventura en la Patagonia comienza aquí</h2>
      <button class="mt-8 px-8 py-4 bg-green-700 text-white rounded-lg font-bold">Descargar App</button>
    </section>
  </main>
</Layout>
