---
import Layout from '../../layouts/Layout.astro';
import {
  fetchPrestadores,
  fetchCategoriasOficio,
  nombreEspecialidad,
  type PrestadorListItem,
  type Categoria,
} from '../../config/api';

export const prerender = false;

let prestadores: PrestadorListItem[] = [];
let categorias: Categoria[] = [];
let total = 0;
let errorMsg: string | null = null;

try {
  const [dataPrest, dataCats] = await Promise.all([
    fetchPrestadores(),
    fetchCategoriasOficio(),
  ]);
  // Filtrar verificados con datos completos (evita crashes con datos null)
  prestadores = dataPrest.items.filter(
    (p) => p.verificado && p.categoria && Array.isArray(p.especialidades),
  );
  total = prestadores.length;
  categorias = dataCats;
} catch {
  errorMsg = 'No se pudo cargar el listado de prestadores.';
}
---

<Layout title="Oficios y Servicios | Baqueano Natales">
  <main class="min-h-screen bg-slate-950 text-slate-100 pb-24">
    <header class="border-b border-emerald-500/20 bg-slate-900/60 p-6 pt-12 text-center">
      <h1 class="text-2xl font-black tracking-tight text-white mb-1">
        Oficios y Servicios
      </h1>
      <p class="text-xs text-slate-400">
        Encuentra mecánicos, gasfiteros, electricistas y más en Puerto Natales
      </p>
      <p id="contador-prestadores" class="text-[10px] text-emerald-400 mt-2 font-semibold">
        {total} {total === 1 ? 'profesional verificado' : 'profesionales verificados'}
      </p>
    </header>

    <div class="max-w-4xl mx-auto px-4 py-6">
      {errorMsg && (
        <div class="p-4 rounded-xl bg-red-950/40 border border-red-500/30 mb-4">
          <p class="text-xs text-red-300">{errorMsg}</p>
        </div>
      )}

      <!-- Chips de filtro (data-chip = slug de categoría) -->
      {categorias.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          <a
            href="/prestadores"
            data-chip=""
            class="px-3 py-1.5 rounded-full text-xs font-bold transition bg-emerald-500 text-slate-950"
          >
            Todos
          </a>
          {categorias.map((cat) => (
            <a
              href={`/prestadores?categoria=${cat.slug}`}
              data-chip={cat.slug}
              class="px-3 py-1.5 rounded-full text-xs font-bold transition bg-slate-900 border border-slate-800 text-slate-400 hover:border-emerald-500/40"
            >
              {cat.nombre}
            </a>
          ))}
        </div>
      )}

      <!-- Empty state para categoría sin resultados -->
      <div
        id="empty-filtro"
        class="hidden text-center py-16"
      >
        <p class="text-4xl mb-3">🔍</p>
        <p class="text-slate-400 text-sm">
          No hay prestadores en esta categoría todavía.
        </p>
        <a
          href="/prestadores"
          class="inline-block mt-4 text-emerald-400 text-xs font-bold hover:underline"
        >
          Ver todos los oficios
        </a>
      </div>

      <!-- Grid de prestadores (data-card-cat = slug de categoría) -->
      <div id="prestadores-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prestadores.map((p) => (
          <a
            href={`/prestadores/${p.slug}`}
            data-card-cat={p.categoria.slug}
            class="prestador-card block bg-slate-900/60 border border-slate-800 rounded-2xl overflow-hidden hover:border-emerald-500/40 transition-all group"
          >
            <!-- Portada -->
            <div class="relative h-32 bg-gradient-to-br from-emerald-900 to-slate-950">
              {p.foto_portada_url ? (
                <img
                  src={p.foto_portada_url}
                  alt={p.nombre}
                  class="w-full h-full object-cover opacity-60"
                  loading="lazy"
                />
              ) : (
                <div class="flex items-center justify-center h-full text-4xl opacity-30">
                  🔧
                </div>
              )}
              {p.destacado && (
                <span class="absolute top-2 right-2 text-[9px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-amber-500/90 text-slate-950">
                  Destacado
                </span>
              )}
            </div>

            <!-- Info -->
            <div class="p-4">
              <div class="flex items-start gap-3 mb-2">
                {p.foto_url ? (
                  <img
                    src={p.foto_url}
                    alt={p.nombre}
                    class="w-12 h-12 rounded-full object-cover border-2 border-slate-950 -mt-8 relative z-10"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-12 h-12 rounded-full bg-emerald-950 border-2 border-slate-950 flex items-center justify-center text-xl -mt-8 relative z-10">
                    🔧
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h2 class="font-bold text-slate-100 text-sm group-hover:text-emerald-400 transition-colors truncate">
                    {p.nombre}
                  </h2>
                  <p class="text-xs text-emerald-400 font-medium">
                    {p.categoria?.nombre ?? 'Sin categoría'}
                  </p>
                </div>
                {p.verificado && (
                  <span class="text-emerald-400 text-sm" title="Verificado">✓</span>
                )}
              </div>

              {p.descripcion && (
                <p class="text-[11px] text-slate-400 mt-1 line-clamp-2">
                  {p.descripcion}
                </p>
              )}

              <div class="flex items-center justify-between mt-3 pt-3 border-t border-slate-800/60">
                <span class="text-[11px] text-slate-400">
                  {p.anios_experiencia ? `${p.anios_experiencia} años exp.` : 'Sin info'}
                </span>
                <span class="text-[10px] font-bold text-amber-400">
                  ★ {Number(p.calificacion_promedio).toFixed(1)} ({p.total_resenas})
                </span>
              </div>

              <div class="flex items-center gap-2 mt-2 text-[10px] flex-wrap">
                {p.atiende_domicilio && (
                  <span class="px-2 py-0.5 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-500/30">
                    A domicilio
                  </span>
                )}
                {p.atiende_emergencias && (
                  <span class="px-2 py-0.5 rounded bg-red-950/60 text-red-400 border border-red-500/30">
                    24/7
                  </span>
                )}
                {(p.especialidades ?? []).slice(0, 2).map((esp) => (
                  <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">
                    {nombreEspecialidad(esp)}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>

      <footer class="mt-12 text-center text-xs text-slate-500 space-y-1">
        <p>Red Baqueano Natales</p>
        <p class="text-[11px]">Tecnología desarrollada por Studio Digital 360</p>
      </footer>
    </div>
  </main>
</Layout>

<script>
  // ============================================================
  // Filtro client-side (compatible con ISR cacheado en Vercel)
  // El HTML se cachea igual; el JS lee window.location.search
  // y aplica el filtro visualmente.
  // ============================================================

  const CLASES_CHIP_ACTIVO = 'px-3 py-1.5 rounded-full text-xs font-bold transition bg-emerald-500 text-slate-950';
  const CLASES_CHIP_INACTIVO = 'px-3 py-1.5 rounded-full text-xs font-bold transition bg-slate-900 border border-slate-800 text-slate-400 hover:border-emerald-500/40';

  function aplicarFiltro() {
    const filtro = new URLSearchParams(window.location.search).get('categoria');
    const cards = document.querySelectorAll<HTMLElement>('[data-card-cat]');
    const chips = document.querySelectorAll<HTMLElement>('[data-chip]');
    const contador = document.getElementById('contador-prestadores');
    const empty = document.getElementById('empty-filtro');

    let visibles = 0;
    cards.forEach((card) => {
      const cat = card.dataset.cardCat;
      const visible = !filtro || cat === filtro;
      card.style.display = visible ? '' : 'none';
      if (visible) visibles++;
    });

    chips.forEach((chip) => {
      const chipCat = chip.dataset.chip;
      const activo = (!filtro && !chipCat) || (filtro === chipCat);
      chip.className = activo ? CLASES_CHIP_ACTIVO : CLASES_CHIP_INACTIVO;
    });

    if (contador) {
      if (filtro) {
        contador.textContent = visibles === 1
          ? '1 profesional en esta categoría'
          : `${visibles} profesionales en esta categoría`;
      } else {
        const total = cards.length;
        contador.textContent = total === 1
          ? '1 profesional verificado'
          : `${total} profesionales verificados`;
      }
    }

    if (empty) {
      empty.style.display = visibles === 0 ? 'block' : 'none';
    }
  }

  // Aplicar al cargar
  aplicarFiltro();

  // Back/forward del navegador
  window.addEventListener('popstate', aplicarFiltro);

  // Interceptar clicks en chips (pushState = sin recarga)
  document.querySelectorAll<HTMLElement>('[data-chip]').forEach((chip) => {
    chip.addEventListener('click', (e) => {
      e.preventDefault();
      const cat = chip.dataset.chip;
      const url = cat ? `/prestadores?categoria=${cat}` : '/prestadores';
      window.history.pushState({}, '', url);
      aplicarFiltro();
    });
  });
</script>
