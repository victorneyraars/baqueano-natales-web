---
interface Props { title: string; }
const { title } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Superapp Baqueano Natales: Guía esencial para Torres del Paine y Puerto Natales." />
  </head>
  <body class="bg-gray-50 text-gray-900">
    <slot />
  </body>
</html>
